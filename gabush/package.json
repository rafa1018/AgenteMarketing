{
  "name": "gabush-kids",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Gabush Kids Jardín Infantil — sitio web",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "images": "node scripts/optimize-images.mjs",
    "og": "node scripts/og-image.mjs",
    "api": "php -S 127.0.0.1:8020 -t public server/dev-router.php",
    "db": "C:/xampp/mysql/bin/mysqld.exe --no-defaults --datadir=.devdb/data --tmpdir=.devdb/tmp --lc-messages-dir=C:/xampp/mysql/share --port=3307 --bind-address=127.0.0.1 --character-set-server=utf8mb4 --collation-server=utf8mb4_unicode_ci --console",
    "migrate": "php server/bin/migrate.php",
    "admin-password": "php scripts/admin-password.php",
    "zip": "node scripts/zip.mjs",
    "deploy": "npm run build && node scripts/deploy.mjs",
    "user": "php scripts/user.php",
    "characters": "node scripts/characters.mjs",
    "lion": "node scripts/lion.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "^5.2.0",
    "@fontsource-variable/nunito": "^5.2.0",
    "lucide-react": "^1.51.0",
    "motion": "^14.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
