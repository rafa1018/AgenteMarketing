# Copiar este archivo a ".env" y completar los valores.
# NUNCA versionar ".env" en Git (ver .gitignore).

# ============ Fase 1: PostgreSQL ============
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n_app
DB_POSTGRESDB_PASSWORD=
DB_POSTGRESDB_SCHEMA=public

# Base de datos propia del sistema (se crea automáticamente en la misma instancia Postgres,
# ver db/init/01-init-databases.sql). Se usa desde la Fase 2 en adelante.
APP_DB_NAME=ai_marketing_agent

# ============ Fase 1: n8n ============
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
# En local (Fase 1-2) puede quedar vacío o en http://localhost:5678.
# Desde la Fase 3 (Telegram) debe ser la URL pública real del túnel/dominio, con https.
N8N_WEBHOOK_URL=
N8N_PROXY_HOPS=0
GENERIC_TIMEZONE=America/Bogota

# Generar UNA SOLA VEZ y no perder (ver README, sección Comandos). Sin esta clave,
# las credenciales cifradas guardadas en Postgres quedan irrecuperables.
N8N_ENCRYPTION_KEY=

# Secreto compartido entre n8n y el sidecar de Task Runners (n8n-runners). Generar igual que
# N8N_ENCRYPTION_KEY, con un valor distinto.
N8N_RUNNERS_AUTH_TOKEN=

# ============ Fase 3: Telegram ============
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ============ Fase 4: proveedor de IA de texto ============
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
OPENROUTER_API_KEY=

# ============ Fase 5: proveedor de imágenes ============
IMAGE_PROVIDER_PRIMARY=gemini
IMAGE_PROVIDER_SECONDARY=openai
IMAGE_MODEL_PRIMARY=gemini-3.1-flash-image
IMAGE_MODEL_SECONDARY=gpt-image-2.5-flare
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=

# ============ Fase 6: Facebook / Instagram ============
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v26.0
META_SYSTEM_USER_TOKEN=

# ============ Fase 7: WhatsApp ============
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ============ Fase 10: Meta Ads (dejar vacío hasta entonces) ============
META_AD_ACCOUNT_ID=

# ============ Configuración del sistema ============
SYSTEM_DEFAULT_TIMEZONE=America/Bogota
SYSTEM_MAX_POSTS_PER_DAY=5
SYSTEM_APPROVAL_REQUIRED=true
SYSTEM_AUTO_PUBLISH=false
SYSTEM_MAX_RETRIES=3
SYSTEM_DEFAULT_LANGUAGE=es
